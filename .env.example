# Copy to .env.local for development, and set these in the hosting dashboard
# for production. Everything here is NEXT_PUBLIC_, so treat it as visible to
# anyone who views the page source — never put a secret key in this file.

# Canonical origin. Used for <link rel="canonical">, Open Graph URLs,
# sitemap.xml and robots.txt. No trailing slash.
# Until this is set the site falls back to https://eclesare.example, which is a
# deliberately non-routable placeholder.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Where the enquiry form POSTs its JSON. Leave empty and the form will
# validate, then tell the visitor plainly that nothing was sent.
# See INTEGRATIONS.md for three options.
NEXT_PUBLIC_FORM_ENDPOINT=

# Shown as a fallback ("email us instead") when the form cannot deliver.
NEXT_PUBLIC_CONTACT_EMAIL=
